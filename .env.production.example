# Copy to .env on the production host and set mode 0600.
# This file contains placeholders only.

PUBLIC_ORIGIN=https://sheets.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters

# Bind to a public address, loopback, or a Tailscale address as appropriate.
HTTPS_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=/etc/letsencrypt/live/sheets.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/sheets.example.com/privkey.pem

IMAGE_TAG=production

UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_REQUEST_BYTES=157286400
UPLOAD_MAX_FILES=10
UPLOAD_USER_STORAGE_BYTES=2147483648
UPLOAD_USER_DAILY_BYTES=524288000
UPLOAD_USER_CONCURRENCY=1
UPLOAD_WORKER_CONCURRENCY=2
UPLOAD_PROCESS_TIMEOUT_MS=30000
UPLOAD_REQUEST_TIMEOUT_MS=120000
UPLOAD_MAX_PDF_PAGES=500
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_STAGING_MAX_AGE_MS=86400000

REMOTE_HOST=deploy@example.invalid
REMOTE_DIR=/srv/mafusheets
APP_NAME=mafusheets
