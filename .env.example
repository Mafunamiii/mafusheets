# Copy this file to `.env` and fill in the values you want to use locally and during deployment.

# Application runtime
HOST=0.0.0.0
PORT=3000
PDFTOPPM_BIN=pdftoppm

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
DELETE_CODE=change-me
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=0

# Optional legacy compatibility value. Prefer ADMIN_PASSWORD or ADMIN_PASSWORD_HASH.
UPLOAD_CODE=

# Deployment script defaults
REMOTE_HOST=deploy@159.223.66.236
REMOTE_DIR=~/mafusheets/
APP_NAME=mafusheets
