# Copy this file to `.env` and fill in the values you want to use locally and during deployment.

# Application runtime
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=
REQUIRE_HTTPS=0
TRUST_PROXY=
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
DATA_DIR=
DATABASE_PATH=
UPLOADS_DIR=
TMP_DIR=
THUMB_DIR=
QUARANTINE_DIR=

# Upload policy. Values are bytes/counts and startup rejects zero, malformed, or
# excessively large values. Set UPLOAD_USER_DAILY_BYTES=disabled only when an
# explicit decision has been made not to enforce the optional daily allowance.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_REQUEST_BYTES=157286400
UPLOAD_MAX_FILES=10
UPLOAD_USER_STORAGE_BYTES=2147483648
UPLOAD_USER_DAILY_BYTES=524288000
UPLOAD_USER_CONCURRENCY=1
UPLOAD_WORKER_CONCURRENCY=2
UPLOAD_PROCESS_TIMEOUT_MS=30000
UPLOAD_REQUEST_TIMEOUT_MS=120000
UPLOAD_MAX_PDF_PAGES=500
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_STAGING_MAX_AGE_MS=86400000

# Accounts are provisioned with `npm run account -- create-user`.
# Set the new password only for that CLI invocation as MAFUSHEETS_NEW_PASSWORD.
# Required: generate at least 32 random characters, for example with:
# openssl rand -base64 48
SESSION_SECRET=
COOKIE_SECURE=0

# Deployment script defaults
REMOTE_HOST=deploy@example.invalid
REMOTE_DIR=/srv/mafusheets/
APP_NAME=mafusheets
