# Install as /etc/mafusheets/offsite-backup.env with mode 0600.
MAFUSHEETS_PROJECT_DIR=/home/deploy/mafusheets
BACKUP_LOCAL_STAGING=/home/deploy/mafusheets/.offsite-backup
BACKUP_REMOTE_HOST=your-home-server-tailnet-name
BACKUP_REMOTE_USER=mafusheets-backup
BACKUP_SSH_PORT=22
BACKUP_SSH_KEY=/home/deploy/.ssh/mafusheets-backup
BACKUP_MAX_BUNDLE_BYTES=21474836480
# Record values from the exact deployed release. Tags alone are not accepted.
BACKUP_APPLICATION_COMMIT=0123456789abcdef0123456789abcdef01234567
BACKUP_IMAGE_DIGEST=sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BACKUP_CONFIG_ID=choir-production-v1
