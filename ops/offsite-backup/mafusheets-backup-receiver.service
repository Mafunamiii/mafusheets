[Unit]
Description=Verify and archive MafuSheets backup uploads

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/mafusheets-backup-receive --max-bytes 21474836480
TimeoutStartSec=30m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
TasksMax=32
MemoryMax=512M
CPUQuota=100%
ReadWritePaths=/var/spool/mafusheets-backup/incoming
ReadWritePaths=/var/lib/mafusheets-backup/work
ReadWritePaths=/srv/backups/mafusheets/quarantine
ReadWritePaths=/srv/backups/mafusheets/archive
